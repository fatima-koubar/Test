  initAndRecognize(
    configs: Partial<Record<PortType, PortSettings>>,
    customer: {
      mail?: string;
      phoneNumber?: string;
    } = {},
  ): Observable<void> {
    return from(
      Promise.allSettled(
        Object.entries(configs).map(async ([portType, portSettings]) => {
          const port = this._ports().find((port) => port.getType() === portType);
          if (!port) {
            return;
          }
          try {
            await firstValueFrom(port.initialize(portSettings));
          } catch (error) {
            return;
          }
          return port;
        }),
      ),
    ).pipe(
      map((promiseSettledResults) =>
        promiseSettledResults
          .filter(
            (
              promiseSettledResult,
            ): promiseSettledResult is PromiseFulfilledResult<ClickToPaySDKPort> =>
              promiseSettledResult.status === 'fulfilled' && Boolean(promiseSettledResult.value),
          )
          .map((promiseFulfilledResult) => promiseFulfilledResult.value),
      ),
      tap((ports) => {
        this._ports.set(ports);
        if (!ports.length) {
          throw new NoPortAvailableError();
        }
      }),
      switchMap(async () => {
        const recognitionCookie = this._recognitionService.get();

        if (!recognitionCookie) {
          return;
        }

        this._paymentStateStore.setValidationChannelOTP(recognitionCookie.contact_info);

        return Promise.any(
          this._ports().map(async (port) => {
            const recognitionResult = await firstValueFrom(
              port.recognize({ recognitionToken: recognitionCookie.device_recognition }),
            );
            if (!recognitionResult.recognized) {
              throw new Error();
            }

            return recognitionResult;
          }),
        ).catch(() => undefined);
      }),
      switchMap(async (recognitionResult) => {
        if (!recognitionResult) {
          if (this._paymentStateStore.isManual() || (!customer?.mail && !customer?.phoneNumber)) {
            this._paymentStateStore.updateStep(PaymentStep.AUTH);
            return [];
          }
          if (customer?.mail) {
            console.log('testtttt');
            return firstValueFrom(
              this.identifyAcrossSchemes({
                email: customer.mail,
              }).pipe(switchMap(() => EMPTY)),
            );
          }
          if (customer?.phoneNumber) {
            return firstValueFrom(
              this.identifyAcrossSchemes({
                mobile: customer.phoneNumber,
              }).pipe(switchMap(() => EMPTY)),
            );
          }

          this._paymentStateStore.updateStep(PaymentStep.AUTH);
          return [];
        }

        this._federatedTokenStore.saveIdentificationToken(
          recognitionResult.identificationTokens[0],
        );

        return Promise.allSettled(
          this._ports().map(async (port) => {
            return {
              srcProfiles: await firstValueFrom(
                port.getSrcProfiles(recognitionResult.identificationTokens),
              ),
              port,
            };
          }),
        );
      }),
      map((promiseSettledResults) =>
        promiseSettledResults
          .filter(
            (
              promiseSettledResult,
            ): promiseSettledResult is PromiseFulfilledResult<{
              srcProfiles: GetSrcProfilesOutput;
              port: ClickToPaySDKPort;
            }> => promiseSettledResult.status === 'fulfilled',
          )
          .map((promiseFulfilledResult) => promiseFulfilledResult.value),
      ),
      tap((srcProfileswithPortArray) => {
        const sdkCardsArray: Array<Array<SdkCard>> = [];
        for (const srcProfilesWithPort of srcProfileswithPortArray) {
          sdkCardsArray.push(srcProfilesWithPort.srcProfiles.cards);
          if (srcProfilesWithPort.srcProfiles.authorisation) {
            this._federatedTokenStore.saveAccessToken(
              srcProfilesWithPort.srcProfiles.authorisation,
            );
          }
        }

        if (!sdkCardsArray.length) {
          console.log('sdkCardsArrayyyyyyy: ' + sdkCardsArray.length);
          this._paymentStateStore.updateStep(PaymentStep.LOG_NO_CARD, 'NO_REGISTERED_CARDS');
          return;
        }
        this._availableCardsStore.saveCards(
          this._cardAggregator.aggregateCards(sdkCardsArray.flat()),
        );

        if (this._availableCardsStore.hasActiveCards()) {
          this._paymentStateStore.updateStep(PaymentStep.CARD_SELECTION);
          return;
        }
        this._paymentStateStore.updateStep(PaymentStep.LOG_NO_CARD, 'NO_ACTIVE_CARDS');
      }),
      switchMap(() => of(void 0)),
    );
  }

  identifyAcrossSchemes(id: IdentificationInput): Observable<void> {
    let identificationRequest: Channel;
    if ('email' in id) {
      identificationRequest = {
        type: CHANNEL_TYPES.EMAIL_ADDRESS,
        value: id.email,
      };
    } else {
      identificationRequest = {
        type: CHANNEL_TYPES.MOBILE_PHONE_NUMBER,
        value: id.mobile,
      };
    }
    switch (identificationRequest.type) {
      case CHANNEL_TYPES.EMAIL_ADDRESS:
        this._paymentStateStore.setValidationChannelOTP(
          this._maskingService.maskEmail(identificationRequest.value),
        );
        break;
      case CHANNEL_TYPES.MOBILE_PHONE_NUMBER:
        this._paymentStateStore.setValidationChannelOTP(
          this._maskingService.maskPhone(identificationRequest.value.replace('-', '')),
        );
        break;
    }
    return from(
      Promise.allSettled(
        this._ports().map(async (port) => {
          return {
            port,
            identificationOutput: await firstValueFrom(port.identify(identificationRequest)),
          };
        }),
      ),
    ).pipe(
      map((promiseSettledResults) =>
        promiseSettledResults
          .filter(
            (
              promiseSettledResult,
            ): promiseSettledResult is PromiseFulfilledResult<{
              port: ClickToPaySDKPort;
              identificationOutput: IdentificationOutput;
            }> => promiseSettledResult.status === 'fulfilled',
          )
          .map((promiseFulfilledResult) => promiseFulfilledResult.value),
      ),
      switchMap(async (outputsWithPort) => {
        const outputsWithPortPresent = outputsWithPort.filter(
          (
            outputWithPort,
          ): outputWithPort is {
            port: ClickToPaySDKPort;
            identificationOutput: Extract<IdentificationOutput, { consumerIsPresent: true }>;
          } => outputWithPort.identificationOutput.consumerIsPresent,
        );

        if (outputsWithPortPresent.length === 0) {
          if (
            this._paymentStateStore.currentStep() === PaymentStep.AUTH ||
            this._paymentStateStore.currentStep() === PaymentStep.INIT
          ) {
            console.log('NO_REGISTERED_CARDS');
            this._paymentStateStore.updateStep(PaymentStep.LOG_NO_CARD, 'NO_REGISTERED_CARDS');
          }
          return Promise.resolve();
        }

        const mostRecentUsedPort = outputsWithPortPresent.reduce(
          (closest, outputWithPort) =>
            (outputWithPort.identificationOutput.lastUsedCardTimestamp ?? 0) <
            (closest.identificationOutput.lastUsedCardTimestamp ?? 0)
              ? outputWithPort
              : closest,
          outputsWithPortPresent[0],
        ).port;

        this.setSelectedPort(mostRecentUsedPort);
        return firstValueFrom(this.startIdentificationValidation(identificationRequest.type));
      }),
    );
  }
